{
  "name": "trail",
  "version": "0.1.2",
  "description": "对话索引面板：/trail 按轮次浏览、筛选、搜索当前会话，点击跳回对话原位置",
  "author": {
    "name": "devilcoolyue",
    "url": "https://github.com/devilcoolyue"
  },
  "homepage": "https://github.com/devilcoolyue/trail",
  "repository": "https://github.com/devilcoolyue/trail",
  "license": "MIT",
  "keywords": [
    "transcript",
    "index",
    "navigation",
    "summary",
    "history"
  ],
  "types": "./types/index.d.ts",
  "userConfig": {
    "summaries": {
      "type": "string",
      "title": "每轮总结",
      "description": "haiku：用小模型生成一句话总结和分类（结果缓存，每轮只总结一次）；off：只用规则提取，不调用模型",
      "default": "haiku",
      "options": [
        "haiku",
        "off"
      ]
    }
  }
}
